# udev-Regel für Servo-Adapter am SO-101 (nur Linux).
#
# Installation:
#   sudo cp config/99-so101.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   Adapter einmal ab- und wieder anstecken.
#
# Wirkung: Der angemeldete Benutzer darf den Port öffnen (TAG uaccess), ohne in der Gruppe
# 'dialout' zu sein, und ModemManager lässt den Adapter in Ruhe.

# QinHeng "USB Single Serial" (USB-ID 1a86:55d3), der bei uns eingesetzte Adapter
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", MODE="0660", GROUP="dialout", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"

# Sind mehrere Adapter gleichzeitig angeschlossen (z. B. Leader und Follower), bekommen sie
# feste Namen über die Seriennummer. Seriennummer ermitteln mit:
#   udevadm info -a -n /dev/ttyACM0 | grep serial
# Dann die folgenden Zeilen anpassen und die Kommentarzeichen entfernen:
# SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="HIER_SERIENNUMMER", SYMLINK+="so101_follower"
# SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="HIER_SERIENNUMMER", SYMLINK+="so101_leader"
